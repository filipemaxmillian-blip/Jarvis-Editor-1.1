# Copie para .env (no seu computador) ou cadastre como variáveis de ambiente na hospedagem.

# Endereço público do servidor, com https (ex.: https://jarvis-social.onrender.com)
PUBLIC_URL=http://localhost:3000
PORT=3000

# Senha para entrar no app
APP_PASSWORD=troque-esta-senha

# Chave secreta longa e aleatória (mínimo 32 caracteres). Protege a sessão e os tokens das contas.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Pasta onde ficam o banco de dados e as mídias enviadas. Na hospedagem, aponte para um disco persistente.
DATA_DIR=./data

# App da Meta (developers.facebook.com > Meus apps > Configurações > Básico)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Texto qualquer que você inventa e repete na configuração de Webhooks da Meta
META_WEBHOOK_VERIFY_TOKEN=
